# Modelo das variáveis de ambiente do backend.
# Copie para .env e preencha com valores próprios — o .env não é versionado.
#   cp .env.example .env
#
# Ver docs/IdleMarket/Setup e Execução.md

# Conexão do Prisma com o Postgres.
# A porta é 5433 porque o docker-compose.yml mapeia "5433:5432" no host.
# Rodando com Postgres nativo (sem Docker), troque para 5432.
DATABASE_URL="postgresql://idlemarket:trocaessasenha@localhost:5433/idlemarket"

# Senha do container do Postgres — o docker-compose.yml lê daqui.
# Precisa ser IDÊNTICA à senha usada no DATABASE_URL acima.
# Sem Docker, esta variável não é usada.
POSTGRES_PASSWORD="trocaessasenha"

# Segredo de assinatura do JWT (@fastify/jwt). Sem isso o servidor não sobe.
# Gere um valor aleatório: openssl rand -hex 32
JWT_SECRET="troque-por-uma-string-aleatoria-longa"
