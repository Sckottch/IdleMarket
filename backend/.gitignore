# ===========================================
# .gitignore — Backend Node.js (server/)
# Node + TypeScript + Prisma
# ===========================================

# Dependências
node_modules/
.pnp
.pnp.js

# Build / saída compilada do TypeScript
dist/
build/
out/

# Variáveis de ambiente (DATABASE_URL, JWT_SECRET, etc.)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cobertura de testes
coverage/
*.lcov
.nyc_output/

# Cache
.cache/
.npm
.eslintcache

# Prisma
# (o schema e as migrations SÃO versionados — não ignorar)
# apenas o cliente gerado, se cair fora de node_modules:
prisma/generated/

# Diversos
*.tsbuildinfo
.DS_Store

/generated/prisma
