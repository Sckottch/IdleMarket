# ===========================================
# .gitignore — Frontend React (web/)
# Vite + React + TypeScript + Tailwind
# ===========================================

# Dependências
node_modules/
.pnp
.pnp.js

# Build / saída do Vite
dist/
dist-ssr/
build/

# Variáveis de ambiente
# (Vite só expõe variáveis com prefixo VITE_)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.vite/
.eslintcache

# Cobertura de testes
coverage/

# Diversos
*.tsbuildinfo
.DS_Store
